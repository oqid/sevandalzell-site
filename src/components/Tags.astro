---
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags" aria-label="Skills">
      {tags.map((t) => (
        <li>{t}</li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0;
    margin-top: 0.4rem;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-small);
    color: var(--ink-soft);
  }

  :global(.cap--center) .tags {
    justify-content: center;
  }

  @media (max-width: 860px) {
    :global(.cap--center) .tags {
      justify-content: flex-start;
    }
  }

  li {
    padding: 0.2rem 0.55rem 0.15rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
  }
</style>
