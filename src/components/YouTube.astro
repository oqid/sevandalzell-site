---
/* A YouTube video that costs nothing until it's wanted: a still with a
   play button (a plain link to YouTube if JavaScript is off). Clicking
   it swaps in YouTube's player, already playing. Nothing loads from
   YouTube before that click, so the page stays fast and nobody is
   tracked just for scrolling past. Uses youtube-nocookie.com. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;           // the bit after youtu.be/
  title: string;        // what it is: read out by screen readers, shown on hover
  poster?: ImageMetadata; // your own still; leave out to use YouTube's thumbnail
  sizes?: string;
  class?: string;
}
const { id, title, poster, sizes = '100vw', class: className } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
---

<div class:list={['yt', className]} data-yt={id} data-photo>
  <a class="yt-poster" href={`https://youtu.be/${id}`} aria-label={`Play video: ${title}`}>
    {
      poster ? (
        <Image src={poster} alt="" widths={[800, 1200, 1600, 2400, 3200].filter((w) => w <= poster.width)} sizes={sizes} loading="lazy" />
      ) : (
        <img src={thumb} alt="" loading="lazy" decoding="async" />
      )
    }
    <span class="yt-play" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" /></svg>
    </span>
    <span class="yt-title label">{title}</span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((box) => {
    box.querySelector('a')?.addEventListener('click', (e) => {
      e.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0&playsinline=1`;
      frame.title = box.querySelector('.yt-title')?.textContent ?? 'Video';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      box.replaceChildren(frame);
      frame.focus();
    });
  });
</script>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .yt-poster,
  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .yt-poster {
    display: block;
    color: #fafafa;
  }

  .yt-poster :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--pan-ease), filter 0.4s ease;
  }

  .yt-poster:hover :global(img) {
    transform: scale(1.015);
    filter: brightness(0.85);
  }

  .yt-play {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: clamp(4rem, 8vw, 6.5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(250 250 250 / 0.92);
    color: #111;
    transition: scale 0.3s var(--pan-ease), background-color 0.3s ease, color 0.3s ease;
  }

  .yt-play svg {
    width: 38%;
    margin-left: 6%;
    fill: currentColor;
  }

  .yt-poster:hover .yt-play,
  .yt-poster:focus-visible .yt-play {
    scale: 1.08;
    background: var(--accent);
    color: #fafafa;
  }

  .yt-title {
    position: absolute;
    left: 1rem;
    bottom: 0.9rem;
    color: #fafafa;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.6);
  }
</style>
