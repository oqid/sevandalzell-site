---
/* One image or video from a project's `media` list. */
import { Image, getImage } from 'astro:assets';
import type { Project } from '../lib/projects';

type Item = Project['data']['media'][number];

interface Props {
  item: Item;
  sizes: string;
  eager?: boolean;
  class?: string;
  /** Show the caption as an overlay on hover (portfolio) instead of below. */
  overlayCaption?: boolean;
}

const { item, sizes, eager = false, class: className, overlayCaption = true } = Astro.props;
const caption = item.caption;

// Resolution: the browser picks from `widths` using `sizes` and the
// screen's pixel density, so a 1.5x or 2x (or 4K) screen downloads a
// bigger file and a phone a smaller one. Nothing is ever upscaled:
// sizes above the original's width are skipped, so for a sharp result
// on big screens the original should be at least ~3000px wide.
const WIDTHS = [480, 800, 1200, 1600, 2000, 2600, 3200];

let full: string | undefined;
if ('image' in item) {
  full = (await getImage({ src: item.image, width: Math.min(3200, item.image.width), quality: 80 })).src;
}
---

<figure class:list={['media', className]} data-photo data-has-caption={caption ? 'true' : undefined}>
  {
    'image' in item ? (
      <Image
        src={item.image}
        alt={item.alt}
        width={Math.min(1600, item.image.width)}
        widths={[...WIDTHS.filter((w) => w < item.image.width), item.image.width].filter((w) => w <= 3200)}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        data-lightbox={full}
        data-caption={caption}
      />
    ) : (
      <video
        src={item.video}
        poster={item.poster}
        aria-label={item.alt}
        muted
        loop
        playsinline
        autoplay
        preload="metadata"
        data-lightbox={item.video}
        data-lightbox-type="video"
        data-caption={caption}
      />
    )
  }
  {caption && <figcaption class:list={['label', { overlay: overlayCaption }]}>{caption}</figcaption>}
</figure>

<style>
  .media {
    position: relative;
    overflow: hidden;
  }

  .media :global(img),
  .media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: zoom-in;
    transition: transform 0.4s var(--pan-ease);
  }

  .media:hover :global(img),
  .media:hover video {
    transform: scale(1.025);
  }

  figcaption {
    margin-top: 0.6rem;
    line-height: 1.5;
  }

  figcaption.overlay {
    position: absolute;
    inset: auto 0 0 0;
    margin: 0;
    padding: 2.5rem 0.9rem 0.8rem;
    color: #fafafa;
    background: linear-gradient(to top, rgb(10 10 10 / 0.8), transparent);
    opacity: 0;
    translate: 0 0.5rem;
    transition: opacity 0.3s ease, translate 0.3s ease;
    pointer-events: none;
  }

  .media:hover figcaption.overlay,
  .media:focus-within figcaption.overlay {
    opacity: 1;
    translate: 0 0;
  }

  /* Touch screens can't hover, so captions just sit under the media. */
  @media (hover: none) {
    figcaption.overlay {
      position: static;
      opacity: 1;
      translate: 0 0;
      padding: 0;
      margin-top: 0.6rem;
      color: var(--ink-soft);
      background: none;
    }
  }
</style>
